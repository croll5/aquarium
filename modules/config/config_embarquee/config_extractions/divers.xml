<!-- Configuration créée grâce à l’analyse effectuée par M. Abderahman Moad-->

<extraction>
    <id>divers</id>
    <extracteur>journaux</extracteur>
    <nom>Journaux divers.log</nom>
    <description>Journaux « divers.log », contenant les informations sur les opérations effectuées par le système</description>
    <table nom="divers_log">
        <colonne type="DATETIME" contenu="1|aqua_encodage:date[aqua_sep]2006/01/02 15:04:05">horodatage</colonne>
        <colonne type="TEXT" contenu="2">operation</colonne>
        <colonne type="TEXT" contenu="4">commande</colonne>
        <colonne type="TEXT" contenu="6">statut</colonne>
    </table>
    <complements>
        <parametre cle="encodage">utf8</parametre>
        <parametre cle="separateur">[Boot Session: </parametre>
        <parametre cle="regex">(\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}).+\][\r\n]+.+  \[(.+)\]([\r\n]+.+)+cmd: (.+)[\r\n]+([\r\n]+.+)+\[Exit status: (.+)\]</parametre>
        <parametre cle="exclusion">[</parametre>
    </complements>
    <sql_chronologie></sql_chronologie>
</extraction>