<?xml version="1.0" encoding="UTF-8"?>
<extraction>
    <id>NTFS_Info</id>
    <extracteur>csv</extracteur> 
    <nom>Fichier NTFS_Info</nom>
    <description>Fichiers NTFS_Info, extrait par ORC, qui contient la liste de tous les fichiers présents sur la machine</description>
    <table nom="ntfs_info">
        <colonne type="TEXT" contenu="aqua_source">source</colonne>
        <colonne type="TEXT" contenu="File">nom_fichier</colonne>
        <colonne type="TEXT" contenu="VolumeID">id_volume</colonne>
        <colonne type="TEXT" contenu="ParentName">emplacement</colonne>
        <colonne type="INT" contenu="SizeInBytes">taille</colonne>
        <colonne type="DATETIME" contenu="CreationDate" indexable="true">date_creation</colonne>
        <colonne type="DATETIME" contenu="LastModificationDate" indexable="true">derniere_modification</colonne>
        <colonne type="DATETIME" contenu="LastAccessDate" indexable="true">dernier_acces</colonne>
        <colonne type="DATETIME" contenu="MD5">md5</colonne>
        <colonne type="DATETIME" contenu="SHA1">sha1</colonne>
        <colonne type="DATETIME" contenu="SHA256">sha256</colonne>
    </table>
    <sql_chronologie></sql_chronologie>
</extraction>