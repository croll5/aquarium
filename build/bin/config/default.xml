<?xml version="1.0" encoding="UTF-8"?>
<extractions>
    <collecte>collecteORC</collecte>
    <chronologie nom="chronologie">
        <colonne type="INT">idEvt</colonne>
        <colonne type="TEXT">extraction</colonne>
        <colonne type="TEXT">nomTable</colonne>
        <colonne type="TEXT">source</colonne>
        <colonne type="DATETIME">horodatage</colonne>
        <colonne type="TEXT">message</colonne>
    </chronologie>
    <extraction>
        <id>Getthis</id>
        <extracteur>csv</extracteur> 
        <nom>Fichiers GetThis</nom>
        <description>Fichiers GetThis, qui contiennent les métadonnées des fichiers collectés par ORC</description>
        <chemin>
            <dossier>*</dossier>
            <archive>*.7z</archive>
            <fichier>GetThis.csv</fichier>
        </chemin>
        <chemin>
            <dossier>*</dossier>
            <fichier>GetThis.csv</fichier>
        </chemin>
        <table nom="getthis">
            <colonne type="TEXT" contenu="source">source</colonne>
            <colonne type="TEXT" contenu="SampleName">chemin_copie</colonne>
            <colonne type="TEXT" contenu="FullName">nom_fichier</colonne>
            <colonne type="TEXT" contenu="MD5">MD5</colonne>
            <colonne type="DATETIME" contenu="CreationDate">date_creation</colonne>
            <colonne type="DATETIME" contenu="LastModificationDate">derniere_modif</colonne>
            <colonne type="DATETIME" contenu="LastAccessDate">dernier_acces</colonne>
        </table>
        <sql_chronologie>SELECT id, "getthis", "creation", source, date_creation AS horodatage, "Création du fichier « " || nom_fichier || " » (empreinte MD5 : " || MD5 || ")" FROM getthis UNION SELECT id, "getthis", "modification", source, derniere_modif as horodatage, "Dernière modification du fichier « " || nom_fichier || " » (empreinte MD5 : " || MD5 || ")" FROM getthis  UNION SELECT id, "getthis", "acces", source, dernier_acces as horodatage, "Dernier accès au fichier « " || nom_fichier || " » (empreinte MD5 : " || MD5 || ")" FROM getthis</sql_chronologie>
    </extraction>
    <extraction>
        <id>Evtx</id>
        <extracteur>evtx</extracteur>
        <nom>Fichiers EVTX</nom>
        <description>Fichiers d'évènements Windows</description>
        <chemin>
            <dossier>General</dossier>
            <archive>Event.7z</archive>
            <fichier>evtx/*</fichier>
        </chemin>
        <table nom="evtx">
            <colonne type="DATETIME" contenu="horodatage">horodatage</colonne>
            <colonne type="TEXT" contenu="source">source</colonne>
            <colonne type="TEXT" contenu="message">Message</colonne>
            <colonne type="TEXT" contenu="Event/System/EventID">EventID</colonne>
            <colonne type="TEXT" contenu="Event/System/Provider/Name">ProviderName</colonne>
            <colonne type="TEXT" contenu="Event/System/Execution/ProcessID">ProcessID</colonne>
            <colonne type="TEXT" contenu="Event/System/Execution/ThreadID">ThreadID</colonne>
            <colonne type="TEXT" contenu="Event/System/Level">Level</colonne>
            <colonne type="TEXT" contenu="Event/System/Provider/Guid">Guid</colonne>
            <colonne type="TEXT" contenu="Event/System/Task">Task</colonne>
        </table>
        <sql_chronologie>SELECT id, "evtx", "evtx", source, horodatage, "eventID : " || EventID || ", providerName : " || ProviderName FROM evtx</sql_chronologie>
    </extraction>
    <extraction>
        <id>SAM</id>
        <extracteur>registre</extracteur>
        <nom>Base SAM, contenant les informations utilisateurs</nom>
        <description>La base SAM contient les informations sur les comptes (date de création, dernière connexion, droits,...)</description>
        <chemin>
            <dossier>SAM</dossier>
            <archive>SAM.7z</archive>
            <fichier>*</fichier>
        </chemin>
        <complements>
            <parametre cle="registre">SAM/Domains/Account/Users</parametre>
            <parametre cle="parcourir_enfants">oui</parametre>
            <parametre cle="exclusions">Names</parametre>
        </complements>
        <table nom="sam">
            <colonne type="DATETIME" contenu="0:fixe:0x8:0x8:filetime">derniereConnexion</colonne>
            <colonne type="DATETIME" contenu="0:fixe:0x18:0x8:filetime">creationCompte</colonne>
            <colonne type="TEXT" contenu="nomCle">idCompte</colonne>
            <colonne type="TEXT" contenu="1:variable:0xC:0x10:utf16">nomCompte</colonne>
            <colonne type="TEXT" contenu="source">source</colonne>
        </table>
        <sql_chronologie>SELECT DISTINCT id, "registre", "sam", source, derniereConnexion, "Date de la dernière connexion sur le compte " || nomCompte || " (idCompte : " || idCompte || ")" FROM sam WHERE derniereConnexion != "n/a" 
            UNION SELECT DISTINCT id, "registre", "sam", source, creationCompte, "Création du compte " || nomCompte || " (idCompte : " || idCompte || ")" FROM sam WHERE creationCompte != "n/a"</sql_chronologie>
    </extraction>
</extractions>