<extraction>
    <id>Evtx</id>
    <extracteur>evtx</extracteur>
    <nom>Fichiers EVTX</nom>
    <description>Fichiers d'évènements Windows</description>
    <table nom="evtx">
        <colonne type="DATETIME" contenu="horodatage">horodatage</colonne>
        <colonne type="TEXT" contenu="aqua_source">source</colonne>
        <colonne type="TEXT" contenu="message">Message</colonne>
        <colonne type="TEXT" contenu="Event/System/EventID">EventID</colonne>
        <colonne type="TEXT" contenu="Event/System/Provider/Name">ProviderName</colonne>
        <colonne type="TEXT" contenu="Event/System/Execution/ProcessID">ProcessID</colonne>
        <colonne type="TEXT" contenu="Event/System/Execution/ThreadID">ThreadID</colonne>
        <colonne type="TEXT" contenu="Event/System/Level">Level</colonne>
        <colonne type="TEXT" contenu="Event/System/Provider/Guid">Guid</colonne>
        <colonne type="TEXT" contenu="Event/System/Task">Task</colonne>
    </table>
    <sql_chronologie>SELECT id, "evtx", "evtx", source, horodatage, "eventID : " || EventID || ", providerName : " || ProviderName, aqua_machine FROM evtx</sql_chronologie>
</extraction>