<?xml version="1.0" encoding="UTF-8"?>
<extraction>
    <id>Prefetch</id>
    <extracteur>prefetch</extracteur> 
    <nom>Fichiers de préchargement</nom>
    <description>Fichiers de préchargement, qui contiennent des informations sur les programmes installés et leurs dernières exécutions.</description>
    <table nom="prefetch">
        <colonne type="TEXT" contenu="aqua_source">source</colonne>
        <colonne type="TEXT" contenu="executable">executable</colonne>
        <colonne type="TEXT" contenu="taille_fichier">taille_fichier</colonne>
        <colonne type="TEXT" contenu="empreinte">empreinte</colonne>
        <colonne type="DATETIME" contenu="nb_executions">nb_executions</colonne>
        <colonne type="TEXT" contenu="date_execution">dates_executions</colonne>
        <colonne type="DATETIME" contenu="version">version</colonne>
        <colonne type="TEXT" contenu="ressource">liste_ressources</colonne>
    </table>
    <table nom="executions_prefetch" condition="date_execution">
        <colonne type="STRING" contenu="empreinte">empreinte</colonne>
        <colonne type="DATETIME" contenu="date_execution">horodatage</colonne>
    </table>
    <table nom="ressources_prefetch" condition="ressource">
        <colonne type="STRING" contenu="empreinte">empreinte</colonne>
        <colonne type="DATETIME" contenu="ressource">ressource</colonne>
    </table>
    <sql_chronologie></sql_chronologie>
</extraction>